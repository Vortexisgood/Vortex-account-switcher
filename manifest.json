{
  "manifest_version": 3,
  "name": "Vortex Account Switcher",
  "version": "1.1",
  "description": "Quick account switcher for playvortex.io",
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://playvortex.io/*",
    "*://*.playvortex.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://playvortex.io/*",
        "*://*.playvortex.io/*"
      ],
      "css": [
        "content.css"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "Vortex Account Switcher",
    "default_popup": "popup.html"
  }
}
